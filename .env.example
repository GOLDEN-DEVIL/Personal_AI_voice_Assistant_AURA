# Project AURA Environment Configuration
# Copy this file to .env and customize as needed. Never commit your real .env file.

# Workspace directory for file operations (defaults to project's ./data folder if unset)
AURA_WORKSPACE_DIR=./data

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
AURA_LOG_LEVEL=INFO

# Voice Input & Output Settings (Stage 3)
AURA_TTS_ENABLED=false
AURA_TTS_RATE=180
AURA_TTS_VOLUME=0.9

# Online AI Provider Settings (Stage 4)
# Provider options: nvidia (default), gemini
AURA_AI_PROVIDER=nvidia

# NVIDIA NIM API key — get a free key at: https://build.nvidia.com
# Key format: nvapi-...
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model to use — browse available models at: https://build.nvidia.com/explore/discover
AURA_AI_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# --- Optional: Google Gemini fallback ---
# AURA_AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# AURA_AI_MODEL=gemini-1.5-flash
