# Project AURA Environment Configuration
# Copy this file to .env and customize as needed. Never commit your real .env file.

# Workspace directory for file operations (defaults to project's ./data folder if unset)
AURA_WORKSPACE_DIR=./data

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
AURA_LOG_LEVEL=INFO

# Future integrations (reserved for subsequent stages)
# AURA_AI_PROVIDER=
# AURA_AI_API_KEY=
# AURA_TTS_ENABLED=false
